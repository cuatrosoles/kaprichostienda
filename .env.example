# Kaprichos — Next.js + Payload CMS 3.x
#
# Copiá este archivo a .env.local y reemplazá los placeholders.
# En Vercel, cargá las mismas variables en Project Settings → Environment Variables.

# URL pública de la tienda (localhost en dev, dominio de Vercel en producción)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# URL pública para webhooks (en local: túnel ngrok; en producción: la URL de Vercel)
NEXT_PUBLIC_WEBHOOK_URL=http://localhost:3000

# Mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=CAMBIAR_POR_UN_SECRET_DE_32_CARACTERES_O_MAS

# Supabase → Session pooler (puerto 5432). Ver README.
# Ejemplo (Session pooler, puerto 5432). Si la contraseña tiene !, escribilas como %21
DATABASE_URI=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Mercado Pago Argentina (Access Token de producción o test)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-XXXXXX-XXXXXX-XXXXXX-XXXXXX

# Cloudinary (plan Free)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_FOLDER=kaprichos
